// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Workflow {
  id        String   @id @default(cuid())
  name      String
  nodes     Json
  edges     Json
  userId    String

  runs      RunHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RunHistory {
  id          String   @id @default(cuid())

  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  status      RunStatus @default(PENDING)
  duration    Float?

  logs        Json
  nodeResults Json

  startedAt   DateTime @default(now())
  finishedAt  DateTime?

  createdAt   DateTime @default(now())

  @@index([workflowId])
  @@index([status])
}